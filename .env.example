# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# LINE OAuth
LINE_CLIENT_ID=your-line-channel-id
LINE_CLIENT_SECRET=your-line-channel-secret

# E2E Test Credentials
TEST_GOOGLE_EMAIL=your-test-google-account@gmail.com
TEST_GOOGLE_PASSWORD=your-test-google-password
TEST_LINE_EMAIL=your-test-line-email
TEST_LINE_PASSWORD=your-test-line-password

# Google Cloud KMS (for credential encryption)
GCP_PROJECT_ID=your-gcp-project-id
GCP_KMS_KEYRING=your-keyring-name
GCP_KMS_KEY=your-key-name
GCP_KMS_LOCATION=asia-northeast1
